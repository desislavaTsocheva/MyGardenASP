@model IEnumerable<MyGardenWEB.Data.Order>

@{
    ViewData["Title"] = "Кошница";
}

<h1>Кошница</h1>

<p>
    <a asp-action="Create" class="btn-create-admin">Поръчай</a>
</p>

@if (User.IsInRole("Admin"))
{
    <table class="table-admin">
        <thead>
            <tr>
                <th>Продукт</th>
                <th>Клиент</th>
                <th>Количество</th>
                <th>Снимка</th>
                <th>Обща цена</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Products.BulgarianName</td>
                    <td>@item.Clients.UserName</td>
                    <td>@item.Quantity</td>
                    <td><img src="@item.Products.PhotoURL" width="120" height="auto" /></td>
                    <td><b>@item.Price</b></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-action edit">Редактиране</a>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn-action details">Детайли</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-action delete">Изтриване</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="self-grid">
        @foreach (var item in Model)
        {
            <div class="card">
                <img src="@item.Products.PhotoURL" class="card-img" />
                <div class="card-body">
                    <h5 class="card-title"><b>@item.Products.BulgarianName</b></h5>
                    <h6 class="card-subtitle mb-2 text-muted">/@item.Products.LatinName/</h6>
                    <p>Количество: @item.Quantity</p>
                    <p>Обща цена: <b>@item.Price</b></p>

                    <div class="overlay_product">
                        <div class="buttons">
                            <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.Id">Детайли</a>
                            <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.Id">Редактирай</a>
                            <a class="btn btn-primary" asp-action="Delete" asp-route-id="@item.Id">Изтриване</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<div class="calculate">
    @{
        decimal sum = Model.Sum(i => i.Price);
    }
    <p>Вашата сметка е: <b>@sum лева</b></p>
</div>

<form asp-action="EmptyCart" asp-controller="Orders" method="post">
    <input type="submit" value="Поръчай" class="btn-create-admin" onclick="showAlert()" />
</form>

<script>
    function showAlert() {
        alert('Благодарим за Вашата поръчка!');
    }
</script>

<style>
    .btn-create-admin {
        background-color: #ff7aa2;
        color: white;
        padding: 10px 22px;
        border-radius: 30px;
        font-weight: 600;
        text-decoration: none;
        transition: 0.3s;
        display: inline-block;
        margin-bottom: 15px;
    }

        .btn-create-admin:hover {
            background-color: #4d2539;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 122, 162, 0.3);
            color: white;
        }
    .table-admin {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
        font-family: Arial, sans-serif;
    }

        .table-admin th, .table-admin td {
            padding: 10px;
            border-bottom: 1px solid #ddd;
            text-align: left;
        }

        .table-admin th {
            background-color: #f8f9fa;
            text-transform: uppercase;
            color: #888;
            font-size: 0.85rem;
            letter-spacing: 1px;
        }

        .table-admin tr:nth-child(even) {
            background-color: #fafafa;
        }
    .self-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
    }

    .card {
        border: 1px solid #ddd;
        border-radius: 10px;
        width: 30%;
        overflow: hidden;
        position: relative;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .card-img {
        width: 100%;
        height: 230px;
        object-fit: cover;
    }

    .card-body {
        padding: 15px;
    }

    .overlay_product {
        margin-top: 10px;
        display: flex;
        gap: 5px;
    }

        .overlay_product .btn {
            font-size: 0.85rem;
            padding: 5px 10px;
            border-radius: 6px;
        }

    .calculate {
        margin-top: 20px;
        font-size: 1.1rem;
        font-weight: 600;
    }

    .btn-action {
        padding: 4px 8px;
        border-radius: 6px;
        color: white;
        text-decoration: none;
        margin-right: 3px;
        transition: 0.2s;
    }

        .btn-action.edit {
            background-color: #1976d2;
        }

        .btn-action.details {
            background-color: #7b1fa2;
        }

        .btn-action.delete {
            background-color: #d32f2f;
        }

        .btn-action:hover {
            opacity: 0.8;
        }
</style>
