@model MyGardenWEB.Data.Promotion
@{
    ViewData["Title"] = "Промоция: " + Model.Products.BulgarianName;
}

<div class="product-details container py-5">
    <div class="row g-5 align-items-start">
        <div class="col-lg-6">
            <div class="gallery-layout">
                <div class="thumbnail-column">
                    <div class="thumb-wrapper">
                        <img src="@Url.Content(Model.Products.PhotoURL)"
                             class="clickable-thumb"
                             onclick="updateMainImage(this)"
                             alt="thumbnail" />
                    </div>
                </div>

                <div class="main-display">
                    <div class="discount-badge">-@Model.PromotionPercent%</div>
                    <img id="mainImage"
                         src="@Model.Products.PhotoURL"
                         alt="@Model.Products.BulgarianName"
                         class="active-main-img" />
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <h1 class="product-title">@Model.Products.BulgarianName</h1>
            <p class="latin-name">/ @Model.Products.LatinName /</p>

            <div class="price-box-promo">
                <p class="old-price">Стара цена: @Model.Products.Price лв.</p>
                <p class="new-price">
                    @(Model.Products.Price - Model.Products.Price / 100 * Model.PromotionPercent) лв.
                </p>
                <span class="size-tag">Размер: @Model.Products.Size</span>
            </div>

            <div class="buy-box promo-highlight">
                <p class="promo-info-text">⭐ Промоцията важи при поръчка на минимум 2 броя!</p>
                <form asp-controller="Orders" asp-action="CreateWithPromotionId" method="get" class="buy-form">
                    <input type="hidden" name="promotionId" value="@Model.Id" />
                    <input type="hidden" name="percent" value="@Model.PromotionPercent" />

                    <div class="qty-field">
                        <label>Броя</label>
                        <input type="number" name="countP" id="ccount" value="2" min="2" />
                    </div>

                    <button type="submit" class="btn-buy">
                        Добави в количката
                    </button>
                </form>
            </div>
        </div>
    </div>

    <div class="description-section mt-5">
        <h3>Описание</h3>
        <p class="description-text">@Model.Products.Description</p>
    </div>

    <div class="mt-4">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-admin">Редактиране</a>
        }
        <a asp-action="Index" class="btn-back">← Назад</a>
    </div>
</div>

<script>
    function updateMainImage(thumbElement) {
        const mainImg = document.getElementById('mainImage');
        if (mainImg && thumbElement) {
            mainImg.style.opacity = '0.3';
            setTimeout(() => {
                mainImg.src = thumbElement.src;
                mainImg.style.opacity = '1';
            }, 150);

            document.querySelectorAll('.thumb-wrapper').forEach(wrapper => {
                wrapper.style.borderColor = '#eee';
            });
            thumbElement.parentElement.style.borderColor = '#ff7aa2';
        }
    }
</script>

<style>
    .gallery-layout {
        display: flex;
        gap: 20px;
        align-items: flex-start;
    }

    .thumbnail-column {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100px;
        max-height: 550px;
        overflow-y: auto;
        padding: 5px;
    }

    .thumb-wrapper {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid #eee;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .thumb-wrapper:hover {
            border-color: #ff7aa2;
            transform: scale(1.05);
        }

    .clickable-thumb {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .main-display {
        flex: 1;
        background: #fff;
        border-radius: 20px;
        padding: 15px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 450px;
    }

    .discount-badge {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #ff7aa2;
        color: white;
        padding: 8px 15px;
        border-radius: 10px;
        font-weight: bold;
        z-index: 5;
    }

    .active-main-img {
        max-width: 100%;
        max-height: 500px;
        object-fit: contain;
        transition: opacity 0.3s ease;
    }

    .product-title {
        font-size: 2.8rem;
        font-weight: 700;
        margin: 0;
    }

    .latin-name {
        font-style: italic;
        color: #888;
        font-size: 1.3rem;
        margin-bottom: 20px;
    }

    .price-box-promo {
        margin-bottom: 25px;
    }

    .old-price {
        text-decoration: line-through;
        color: #999;
        font-size: 1.2rem;
        margin: 0;
    }

    .new-price {
        color: #e91e63;
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0;
    }

    .size-tag {
        background: #f2f2f2;
        padding: 5px 15px;
        border-radius: 20px;
        font-size: 0.9rem;
        display: inline-block;
        margin-top: 10px;
    }

    .buy-box {
        background: #fafafa;
        padding: 25px;
        border-radius: 20px;
    }

    .promo-highlight {
        border: 2px dashed #ff7aa2;
    }

    .promo-info-text {
        color: #4d2539;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .buy-form {
        display: flex;
        align-items: flex-end;
        gap: 15px;
    }

    .qty-field {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .qty-field input {
            width: 80px;
            padding: 10px;
            border-radius: 10px;
            border: 1px solid #ccc;
            text-align: center;
        }

    .btn-buy {
        background: #4d2539;
        color: white;
        font-weight: bold;
        padding: 12px 30px;
        border-radius: 30px;
        border: none;
        transition: 0.3s;
        height: 48px;
        cursor: pointer;
    }

        .btn-buy:hover {
            background: #ff7aa2;
            transform: translateY(-2px);
        }

    .description-section {
        border-top: 1px solid #eee;
        padding-top: 30px;
    }

    .description-text {
        font-size: 1.1rem;
        line-height: 1.8;
        color: #444;
        white-space: pre-line;
    }

    .btn-admin {
        background: #ffc107;
        padding: 10px 20px;
        border-radius: 20px;
        color: black;
        text-decoration: none;
        margin-right: 10px;
        display: inline-block;
    }

    .btn-back {
        color: #555;
        text-decoration: none;
        display: inline-block;
    }

    .thumbnail-column::-webkit-scrollbar {
        width: 4px;
    }

    .thumbnail-column::-webkit-scrollbar-thumb {
        background: #ddd;
        border-radius: 10px;
    }
</style>