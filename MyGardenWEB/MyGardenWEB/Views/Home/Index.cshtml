@model IEnumerable<MyGardenWEB.Data.Product>
@{
    ViewData["Title"] = "Начало - Моята градина";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@300;400&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/swiffy-slider@1.5.3/dist/js/swiffy-slider.min.js" crossorigin="anonymous" defer></script>
<link href="https://cdn.jsdelivr.net/npm/swiffy-slider@1.5.3/dist/css/swiffy-slider.min.css" rel="stylesheet" crossorigin="anonymous">

<div class="hero-wrapper">
    <div class="swiffy-slider slider-item-ratio slider-item-ratio-21x9 slider-nav-round slider-nav-visible slider-indicators-outside" id="main-slider">
        <ul class="slider-container">
            <li>
                <div class="slide-content">
                    <img src="./images/snimka3.jpg" loading="lazy" alt="Разсадник">
                    <div class="slide-overlay">
                        <h1 class="animate-up">Разсадник за цветя <br /> <span>"Моята градина"</span></h1>
                    </div>
                </div>
            </li>
            <li>
                <div class="slide-content">
                    <img src="./images/snimka5.jpg" loading="lazy" alt="Цветя">
                    <div class="slide-overlay">
                        <h2>Голямо разнообразие от цветя, луковици и разсади</h2>
                    </div>
                </div>
            </li>
            <li>
                <div class="slide-content">
                    <img src="./images/snimka2.jpg" loading="lazy" alt="Разнообразие">
                    <div class="slide-overlay">
                        <h2>Всяко едно растение е отгледано от нас с много внимание и грижа</h2>
                    </div>
                </div>
            </li>
        </ul>
        <button type="button" class="slider-nav"></button>
        <button type="button" class="slider-nav slider-nav-next"></button>
        <div class="slider-indicators">
            <button class="active"></button>
            <button></button>
        </div>
    </div>
</div>

<section class="welcome-section text-center">
    <h1 class="main-title">Добре дошли!</h1>
    <p class="subtitle">При нас можете да откриете голямо разнообразие от цветя, разсади и луковици, отгледани с любов.</p>
    <div class="custom-hr"></div>
</section>

<div class="container py-5">
    <div class="row g-4 justify-content-center">
        <div class="col-md-4">
            <div class="category-card">
                <div class="card-img-wrapper">
                    <img src="./images/tsvete1.jpg" alt="Цветя">
                    <div class="card-action">
                        <a asp-controller="Products" asp-action="Index" class="btn-explore">Виж още</a>
                    </div>
                </div>
                <div class="card-body">
                    <h3 class="title-art">Цветя</h3>
                    <p class="description">Цветята са идеалният начин да накарате някой да се почувства обичан и ценен.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="category-card">
                <div class="card-img-wrapper">
                    <img src="./images/razsad.jpg" alt="Разсади">
                    <div class="card-action">
                        <a asp-controller="Products" asp-action="IndexProduct" class="btn-explore">Виж още</a>
                    </div>
                </div>
                <div class="card-body">
                    <h3 class="title-art">Разсади</h3>
                    <p class="description">Млади растения, отгледани в нашите оранжерии с професионална грижа.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="category-card">
                <div class="card-img-wrapper">
                    <img src="./images/lukovitsa.jpg" alt="Луковици">
                    <div class="card-action">
                        <a asp-controller="Products" asp-action="IndexProduct" class="btn-explore">Виж още</a>
                    </div>
                </div>
                <div class="card-body">
                    <h3 class="title-art">Луковици</h3>
                    <p class="description">Висококачествени луковици за вашата прекрасна пролетна градина.</p>
                </div>
            </div>
        </div>
    </div>
</div>
