@page
@model RegisterModel
@{
    ViewData["Title"] = "Създаване на акаунт";
}

<div class="register-container">
    <div class="register-card shadow-lg">
        <div class="register-header text-center">
            <h2 class="fw-bold">Стани част от нас</h2>
            <p class="text-muted">Създай своя акаунт в "Моята градина"</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="mt-4">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.FirstName" class="form-control custom-input" autocomplete="off" placeholder="Име" />
                        <label asp-for="Input.FirstName">Име</label>
                        <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.LastName" class="form-control custom-input" autocomplete="off" placeholder="Фамилия" />
                        <label asp-for="Input.LastName">Фамилия</label>
                        <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.UserName" class="form-control custom-input" autocomplete="off" placeholder="Псевдоним" />
                <label asp-for="Input.UserName">Псевдоним</label>
                <span asp-validation-for="Input.UserName" class="text-danger small"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control custom-input" autocomplete="off" placeholder="Имейл" />
                <label asp-for="Input.Email">Имейл</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" type="password" class="form-control custom-input" autocomplete="off" placeholder="Парола" />
                        <label asp-for="Input.Password">Парола</label>
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating mb-3">
                        <input asp-for="Input.ConfirmPassword" type="password" class="form-control custom-input" autocomplete="off" placeholder="Повтори парола" />
                        <label asp-for="Input.ConfirmPassword">Повтори парола</label>
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <button id="registerSubmit" type="submit" class="w-100 btn-register mt-3 mb-4">Регистрирай се</button>

            <div class="register-footer text-center">
                <p>Вече имате акаунт? <a asp-page="./Login" class="login-link fw-bold">Влезте тук</a></p>
            </div>
        </form>
    </div>
</div>

<style>
    .register-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 85vh;
        padding: 40px 20px;
    }

    .register-card {
        background: #fff;
        width: 100%;
        max-width: 600px;
        padding: 40px;
        border-radius: 24px;
        border: none;
    }

    .register-logo {
        height: 70px;
        width: auto;
    }

    .custom-input {
        border-radius: 12px;
        border: 1px solid #eee;
    }

        .custom-input:focus {
            border-color: #ff7aa2;
            box-shadow: 0 0 0 3px rgba(255, 122, 162, 0.1);
        }

    .btn-register {
        background: #4d2539;
        color: white;
        padding: 12px;
        border-radius: 12px;
        border: none;
        font-weight: 600;
        font-size: 1.1rem;
        transition: 0.3s;
    }

        .btn-register:hover {
            background: #ff7aa2;
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(255, 122, 162, 0.3);
        }

    .login-link {
        color: #ff7aa2;
        text-decoration: none;
        transition: 0.2s;
    }

        .login-link:hover {
            color: #4d2539;
            text-decoration: underline;
        }

    .register-footer {
        border-top: 1px solid #f5f5f5;
        padding-top: 20px;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}